# =============================================================
# MiroFast Configuration
# =============================================================
# Laya makes the decisions; an LLM only writes prose (personas,
# posts/comments, reports). All prose endpoints are optional
# per-purpose overrides of the LLM_* defaults below.
# Copy this file to .env and adjust values for your setup.
# =============================================================

# ===== Laya Decision Engine (System 1) =====
# Checkpoint: multilingual (default, 100+ languages, 1024 ctx) or english
LAYA_MODEL=multilingual
# Device: auto | cuda | cpu | mps
LAYA_DEVICE=auto
# States per forward pass in batched decisions
LAYA_BATCH_SIZE=16
# Preload checkpoints at engine init (recommended)
LAYA_PRELOAD=1
# Decisions below this calibrated confidence can fall back to an LLM
# decision per agent when LAYA_LLM_FALLBACK is enabled
LAYA_CONFIDENCE_THRESHOLD=0.55
# Route low-confidence decisions to the original LLM tool-calling step
LAYA_LLM_FALLBACK=false
# Screen LLM-generated content with a Laya moderation gate before posting
LAYA_MODERATE_CONTENT=true
# Toxicity probability (0-1) that blocks generated content
LAYA_MODERATION_THRESHOLD=0.8
# Torch CPU threads for Laya inference (default: min(8, cores)).
# Oversubscription (torch's default of all logical cores) is 20x slower.
# LAYA_THREADS=8

# ===== Generation LLM (default for all prose) =====
# OpenAI-compatible endpoint: local Ollama, or any cloud provider
# (DashScope, DeepInfra, OpenAI, ...) — works with everything.
LLM_API_KEY=ollama
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL_NAME=qwen2.5:14b
# Cloud example:
# LLM_API_KEY=sk-...
# LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_MODEL_NAME=qwen-plus

# ===== Per-purpose generation overrides (all optional) =====
# Any of {POSTS,PROFILES,ONTOLOGY,NER,REPORT,INTERVIEW}_API_KEY / _BASE_URL /
# _MODEL can redirect that workload. Example: cheap local model for simulated
# posts, strong cloud model for reports:
# POSTS_API_KEY=ollama
# POSTS_BASE_URL=http://localhost:11434/v1
# POSTS_MODEL=qwen2.5:7b
# REPORT_API_KEY=sk-...
# REPORT_BASE_URL=https://api.deepinfra.com/v1/openai
# REPORT_MODEL=qwen/qwen2.5-72b-instruct

# ===== Agent config generation =====
# false (default): Laya scores stance/sentiment + deterministic rules
# true: restore the original per-batch LLM config generation
USE_LLM_FOR_AGENT_CONFIGS=false

# ===== Report generation =====
# true (default): Laya plans the per-section tool sequence (~2 LLM calls
# per section instead of ~6). false: original LLM-driven ReACT loop.
MIROFAST_PLAN_TOOLS=true

# ===== Neo4j Configuration =====
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=mirofish

# ===== Embedding Configuration (Ollama native endpoint) =====
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_BASE_URL=http://localhost:11434

# ===== OASIS / CAMEL-AI (agent interviews use this LLM) =====
OPENAI_API_KEY=ollama
OPENAI_API_BASE_URL=http://localhost:11434/v1

# ===== Docker-mode overrides =====
# LLM_BASE_URL=http://ollama:11434/v1
# NEO4J_URI=bolt://neo4j:7687
# EMBEDDING_BASE_URL=http://ollama:11434
# OPENAI_API_BASE_URL=http://ollama:11434/v1